<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2ec5ff"/>
      <stop offset="0.5" stop-color="#7b5cff"/>
      <stop offset="1" stop-color="#ff7a1a"/>
    </linearGradient>
    <radialGradient id="bg" cx="0.5" cy="0.4" r="0.7">
      <stop offset="0" stop-color="#14264d"/>
      <stop offset="1" stop-color="#070d20"/>
    </radialGradient>
    <linearGradient id="flame" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ff3d00" stop-opacity="0"/>
      <stop offset="1" stop-color="#ffb300"/>
    </linearGradient>
    <clipPath id="disc"><circle cx="256" cy="256" r="228"/></clipPath>
  </defs>

  <!-- dış halka -->
  <circle cx="256" cy="256" r="248" fill="url(#ring)"/>
  <circle cx="256" cy="256" r="232" fill="url(#bg)"/>

  <g clip-path="url(#disc)">
    <!-- saha -->
    <g stroke="#ffffff" stroke-opacity="0.2" stroke-width="5" fill="none">
      <rect x="60" y="130" width="392" height="230" rx="14"/>
      <line x1="256" y1="130" x2="256" y2="360"/>
      <circle cx="256" cy="245" r="42"/>
      <rect x="60" y="195" width="52" height="100"/>
      <rect x="400" y="195" width="52" height="100"/>
    </g>
    <!-- kaleler -->
    <rect x="48" y="215" width="12" height="60" fill="#2ec5ff"/>
    <rect x="452" y="215" width="12" height="60" fill="#ff7a1a"/>

    <!-- taktik yolu -->
    <path d="M110 320 C 170 330, 190 200, 270 235 S 380 250, 430 245" fill="none" stroke="#ffffff" stroke-width="9" stroke-linecap="round" stroke-dasharray="2 20" stroke-opacity="0.9"/>
    <path d="M414 224 L446 245 L414 266 Z" fill="#ffffff"/>

    <!-- X ve O işaretleri -->
    <g stroke="#2ec5ff" stroke-width="10" stroke-linecap="round">
      <line x1="95" y1="305" x2="125" y2="335"/><line x1="125" y1="305" x2="95" y2="335"/>
      <line x1="170" y1="160" x2="196" y2="186"/><line x1="196" y1="160" x2="170" y2="186"/>
    </g>
    <g fill="none" stroke="#ff7a1a" stroke-width="10">
      <circle cx="340" cy="170" r="15"/>
      <circle cx="350" cy="320" r="15"/>
    </g>

    <!-- top + boost alevi -->
    <path d="M150 232 L238 245 L150 258 Z" fill="url(#flame)" opacity="0.0"/>
    <circle cx="270" cy="236" r="30" fill="#fff"/>
    <circle cx="270" cy="236" r="30" fill="none" stroke="#ff7a1a" stroke-width="6"/>
    <path d="M270 218 l12 9 -4 14 h-16 l-4 -14 z" fill="#14264d"/>
  </g>

  <!-- yazı şeridi -->
  <rect x="96" y="372" width="320" height="76" rx="18" fill="#070d20" stroke="url(#ring)" stroke-width="5"/>
  <text x="256" y="425" text-anchor="middle" font-family="Arial Black, Impact, Helvetica, sans-serif" font-weight="900" font-size="46" letter-spacing="3" fill="#ffffff">RL<tspan fill="#ff8a1f">TACTIC</tspan></text>
</svg>
